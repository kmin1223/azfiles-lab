{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_comment": "Precompiled from main.bicep so attendees need NO Bicep CLI. Deploys VNet(DNS->DC), DC VM, client VM, storage account + share. Keep in sync with main.bicep."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Location for all resources" }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "labadmin",
      "metadata": { "description": "Admin username for both VMs (also becomes domain admin)" }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": { "description": "Admin password for VMs / domain admin / lab users" }
    },
    "prefix": {
      "type": "string",
      "defaultValue": "azflab",
      "metadata": { "description": "Resource name prefix" }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_B2ms",
      "metadata": { "description": "VM size" }
    }
  },
  "variables": {
    "labTags": {
      "SecurityControl": "ignore"
    },
    "saName": "[toLower(concat(parameters('prefix'), uniqueString(resourceGroup().id)))]",
    "vnetName": "[concat(parameters('prefix'), '-vnet')]",
    "nsgName": "[concat(parameters('prefix'), '-nsg')]",
    "dcName": "[concat(parameters('prefix'), '-dc')]",
    "clientName": "[concat(parameters('prefix'), '-cli')]",
    "dcIp": "10.100.0.4",
    "subnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'lab')]",
    "_comment_ips": "Both NICs use STATIC addresses on purpose. The copy loop below runs in parallel, so a dynamically-assigned client NIC could grab 10.100.0.4 before the DC NIC claims it (PrivateIPAddressIsAllocated).",
    "vms": [
      { "name": "[concat(parameters('prefix'), '-dc')]", "ip": "10.100.0.4" },
      { "name": "[concat(parameters('prefix'), '-cli')]", "ip": "10.100.0.5" }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('labTags')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-RDP",
            "properties": {
              "priority": 1000,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "AzureCloud",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "3389"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('labTags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
      ],
      "properties": {
        "addressSpace": { "addressPrefixes": [ "10.100.0.0/16" ] },
        "dhcpOptions": { "dnsServers": [ "[variables('dcIp')]" ] },
        "subnets": [
          {
            "name": "lab",
            "properties": {
              "addressPrefix": "10.100.0.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vms')[copyIndex()].name, '-pip')]",
      "location": "[parameters('location')]",
      "tags": "[variables('labTags')]",
      "sku": { "name": "Standard" },
      "properties": { "publicIPAllocationMethod": "Static" },
      "copy": {
        "name": "pipLoop",
        "count": "[length(variables('vms'))]"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vms')[copyIndex()].name, '-nic')]",
      "location": "[parameters('location')]",
      "tags": "[variables('labTags')]",
      "copy": {
        "name": "nicLoop",
        "count": "[length(variables('vms'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', concat(variables('vms')[copyIndex()].name, '-pip'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": { "id": "[variables('subnetId')]" },
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "[variables('vms')[copyIndex()].ip]",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', concat(variables('vms')[copyIndex()].name, '-pip'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "[variables('vms')[copyIndex()].name]",
      "location": "[parameters('location')]",
      "tags": "[variables('labTags')]",
      "copy": {
        "name": "vmLoop",
        "count": "[length(variables('vms'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', concat(variables('vms')[copyIndex()].name, '-nic'))]"
      ],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": {
          "computerName": "[variables('vms')[copyIndex()].name]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": {
            "enableAutomaticUpdates": true,
            "provisionVMAgent": true
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsServer",
            "offer": "WindowsServer",
            "sku": "2022-datacenter-azure-edition",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": { "storageAccountType": "StandardSSD_LRS" }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', concat(variables('vms')[copyIndex()].name, '-nic'))]"
            }
          ]
        },
        "diagnosticsProfile": { "bootDiagnostics": { "enabled": true } }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('saName')]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": { "name": "Standard_LRS" },
      "tags": "[variables('labTags')]",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "allowSharedKeyAccess": true,
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('saName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('saName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('saName'), '/default/labshare')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices', variables('saName'), 'default')]"
      ],
      "properties": { "shareQuota": 100 }
    }
  ],
  "outputs": {
    "storageAccountName": { "type": "string", "value": "[variables('saName')]" },
    "dcVmName": { "type": "string", "value": "[variables('dcName')]" },
    "clientVmName": { "type": "string", "value": "[variables('clientName')]" },
    "dcPublicIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', concat(variables('dcName'), '-pip'))).ipAddress]"
    },
    "clientPublicIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', concat(variables('clientName'), '-pip'))).ipAddress]"
    },
    "vnetName": { "type": "string", "value": "[variables('vnetName')]" },
    "nsgName": { "type": "string", "value": "[variables('nsgName')]" }
  }
}
